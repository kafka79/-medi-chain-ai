# MEdi Chain AI - Environment Configuration
# Copy this file to .env and fill in real values. NEVER commit .env to git.

# MinIO / S3 Storage
MINIO_ACCESS_KEY=changeme-access-key
MINIO_SECRET_KEY=changeme-secret-key

# API Authentication
API_KEY=changeme-strong-api-key
INTERNAL_API_KEY=changeme-strong-internal-key

# Redis
REDIS_URL=redis://redis:6379/0

# Milvus
MILVUS_HOST=standalone
MILVUS_PORT=19530

# Inference API
INFERENCE_API_URL=http://inference-api:8001
MAX_CONCURRENT_REQUESTS=1
